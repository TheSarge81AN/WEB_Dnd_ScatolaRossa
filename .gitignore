# Credenziali e chiavi segrete
.gemini_api_key
utenti_web.json

# Cache Python
__pycache__/
*.py[cod]
*$py.class

# Database SQLite locale (generato automaticamente al primo avvio da avventure_dnd.json)
*.db
*.db-journal
*.db-wal
*.db-shm

# Hash di sincronizzazione manuale
.manuale_hash
*.tmp

# Esportazioni di gioco generate a runtime (mantenute le cartelle)
cronache/*
!cronache/.gitkeep
mappe/*
!mappe/.gitkeep
schede/*
!schede/.gitkeep

# File locali generati dagli IDE
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
